# STOPGAP eMudhra CA (2026-10-22): drop when upstream ships fixed CA store.
# 4.33.0 is the newest diun (built 2026-05-30). diun talks TLS to every
# registry it watches, so it must not trust the compromised roots. Upgrade the
# Alpine CA store to 20261020-r0 (drops emSign ECC Root CA - G3 / AAA Certificate Services).
FROM crazymax/diun:4.33.0@sha256:e324b793eb32dfb7f74d3a39421ebf090141caaadee69b8f78da63112408ee25
USER root
RUN apk upgrade --no-cache ca-certificates ca-certificates-bundle
# upstream image has no USER (runs as root)
