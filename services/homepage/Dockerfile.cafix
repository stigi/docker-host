# STOPGAP eMudhra CA (2026-10-22): drop when upstream ships fixed CA store
# (a homepage release built after 2026-10-20 with Alpine ca-certificates-bundle
# >= 20261020-r0 and Node >= 22.23.4; v2.6.0 from 2026-10-17 is NOT fixed).
# Image runs as root; the entrypoint drops to PUID/PGID.
FROM ghcr.io/gethomepage/homepage:v2.5.0@sha256:57c4a0531937889c0b968b120fe9c2560bbe036b5c9e18c49a9e2479de9975d1
RUN apk upgrade --no-cache ca-certificates ca-certificates-bundle
# Node 22.23.3's bundled CA store still trusts emSign ECC Root CA - G3.
# --use-openssl-ca replaces it with the patched system store (--use-system-ca only adds to it).
ENV NODE_OPTIONS=--use-openssl-ca
