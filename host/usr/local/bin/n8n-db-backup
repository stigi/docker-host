#!/bin/bash
# Writes a CONSISTENT copy of n8n's SQLite database before borgmatic runs.
#
# Same reasoning as forgejo-db-backup. n8n's database.sqlite is ~665MB and holds
# the workflows and their execution history. journal_mode is `delete` rather than
# WAL, so a hot copy is only torn if borg reads it mid-transaction -- narrower
# than Forgejo's exposure, and borg has not caught it in 7 days. But SQLite has
# no self-repair: unlike Prometheus and Loki, which checksum their WALs and
# truncate at the first bad record, a torn SQLite file can simply not open.
#
# Uses VACUUM INTO rather than `.backup`. Both are consistent snapshots of a
# live database, but VACUUM INTO also compacts: this database is 93% free pages
# (151326 of 162389 as of 2026-09-28), so `.backup` copied 665MB of which ~591MB
# was reclaimed space. VACUUM INTO produces 45MB in 2s instead of 665MB in 15s,
# verified to hold the same 1 workflow and 24 executions with integrity ok.
#
# The bloat itself is worth fixing separately: a VACUUM on the live database
# would return ~591MB to the filesystem. That locks the DB while it rewrites, so
# it wants a deliberate moment rather than a backup hook.
#
# Runs on the host: the n8n image ships no sqlite3.
set -euo pipefail

VOL=/var/lib/docker/volumes/n8n_n8n_storage/_data
SRC="$VOL/database.sqlite"
DST="$VOL/database.sqlite.backup"

[ -r "$SRC" ] || { echo "n8n-db-backup: cannot read $SRC" >&2; exit 1; }
command -v sqlite3 >/dev/null || { echo "n8n-db-backup: sqlite3 not installed on the host" >&2; exit 1; }

rm -f "$DST" "$DST-journal" "$DST-wal" "$DST-shm"

if ! out=$(sqlite3 "$SRC" "VACUUM INTO '$DST';" 2>&1); then
  echo "n8n-db-backup: VACUUM INTO failed: $out" >&2
  exit 1
fi

check=$(sqlite3 "$DST" "PRAGMA integrity_check;" 2>&1 | head -1)
[ "$check" = "ok" ] || { echo "n8n-db-backup: integrity_check on the copy: $check" >&2; exit 1; }

size=$(stat -c%s "$DST")
[ "$size" -ge 1048576 ] || { echo "n8n-db-backup: copy implausibly small ($size bytes)" >&2; exit 1; }

chmod 600 "$DST"
echo "n8n-db-backup: database.sqlite -> database.sqlite.backup ($size bytes, integrity ok)"
