[Unit]
Description=Report a pending reboot to ntfy
Documentation=file:///home/docker-host/repo/host/README.md
After=network-online.target
Wants=network-online.target
# Report failures to ntfy; see systemd-failure-notify@.service.
OnFailure=systemd-failure-notify@%n.service

[Service]
Type=oneshot
# Reads two small files and maybe makes one HTTPS request. Cheap, but this host
# is spinning disks, so it queues behind anything real.
IOSchedulingClass=idle
Nice=19
ExecStart=/usr/local/bin/reboot-required-notify
