#!/bin/bash
# Writes a CONSISTENT copy of n8n's SQLite database before borgmatic runs.
#
# Same reasoning as forgejo-db-backup: SQLite has no self-repair. Unlike
# Prometheus and Loki, which checksum their WALs and truncate at the first bad
# record, a torn SQLite file can simply not open.
#
# 2026-09-29: n8n 2.x switched this database to journal_mode=wal (the 2.0 SQLite
# pooling driver). The previous version of this comment claimed `delete`, which
# was true under 1.73. That makes a hot copy MORE exposed, not less: the file on
# disk is not self-contained while the -wal holds committed pages. borgmatic
# therefore excludes database.sqlite, -journal, -wal and -shm, and archives only
# the snapshot this script writes.
#
# Uses VACUUM INTO rather than `.backup`. Both are consistent snapshots of a live
# database, but VACUUM INTO also compacts: this database was 93% free pages, so
# `.backup` copied the whole bloated file while VACUUM INTO writes only live
# pages, faster and far smaller.
#
# DESTINATION IS DELIBERATELY OUTSIDE THE DOCKER VOLUME.
# borgmatic.service runs with CapabilityBoundingSet=CAP_DAC_READ_SEARCH
# CAP_NET_RAW. It is root, but it has no CAP_DAC_OVERRIDE, so it can read
# anything and write only where ordinary permissions already allow it. The n8n
# volume directory is owned by ullrich (0755), so writing the snapshot there
# failed with EACCES the first time this hook ran under systemd -- and because
# it is a `before` hook, that aborted the ENTIRE backup, not just this database.
# It passed when run by hand only because an interactive root shell keeps full
# capabilities.
#
# /var/lib/borgmatic is root-owned, so root writes there with no capability
# override, and it sits inside the /var source directory so the snapshot is
# archived. (/var/backups would NOT work: it is in exclude_patterns.)
#
# Runs on the host: the n8n image ships no sqlite3.
set -euo pipefail

VOL=/var/lib/docker/volumes/n8n_n8n_storage/_data
SRC="$VOL/database.sqlite"
DSTDIR=/var/lib/borgmatic/n8n
DST="$DSTDIR/database.sqlite"

[ -r "$SRC" ] || { echo "n8n-db-backup: cannot read $SRC" >&2; exit 1; }
command -v sqlite3 >/dev/null || { echo "n8n-db-backup: sqlite3 not installed on the host" >&2; exit 1; }

mkdir -p "$DSTDIR"
chmod 700 "$DSTDIR"

rm -f "$DST" "$DST-journal" "$DST-wal" "$DST-shm"

if ! out=$(sqlite3 "$SRC" "VACUUM INTO '$DST';" 2>&1); then
  echo "n8n-db-backup: VACUUM INTO failed: $out" >&2
  exit 1
fi

check=$(sqlite3 "$DST" "PRAGMA integrity_check;" 2>&1 | head -1)
[ "$check" = "ok" ] || { echo "n8n-db-backup: integrity_check on the copy: $check" >&2; exit 1; }

size=$(stat -c%s "$DST")
[ "$size" -ge 1048576 ] || { echo "n8n-db-backup: copy implausibly small ($size bytes)" >&2; exit 1; }

chmod 600 "$DST"
echo "n8n-db-backup: database.sqlite -> $DST ($size bytes, integrity ok)"
